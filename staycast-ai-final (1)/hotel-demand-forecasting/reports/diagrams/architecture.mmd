flowchart LR
  RAW[("data/raw<br/>hotel_bookings.csv<br/>(never modified)")] --> PRE["src/preprocessing.py<br/>clean + dedupe + validate"]
  PRE --> CLEAN[("data/processed<br/>bookings_clean.csv.gz")]
