  TRAIN --> MET[("reports/metrics.json<br/>figures")]
  ART --> PRED["src/predict.py<br/>Forecaster (same FeatureBuilder)"]
  FB --> PRED
  PRED --> API["FastAPI backend<br/>backend/api.py"]
  MET --> API
  API --> UI["Streamlit + Plotly dashboard<br/>frontend/app.py (7 screens)"]
